<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout
            display="{controlPanel: {}}"
            className="'o_dashboard h-100'"
        >
            <t t-set-slot="layout-buttons">
                <button type="button" class="btn btn-primary" t-on-click="openCustomers">
                    Customers
                </button>
                <button type="button" class="btn btn-primary" t-on-click="openLeads">
                    Leads
                </button>
            </t>
            <t t-if="this.statistics.isReady">
                <t t-set="stats" t-value="this.statistics.data" />
                <DashboardItem>
                    <div class="card-body">
                        <h4 class="card-title text-center">
                            The average number of t-shirts by order.
                        </h4>
                        <p class="lead display-3 text-center">
                            <t t-esc="stats.average_quantity" />
                        </p>
                    </div>
                </DashboardItem>
                <DashboardItem size="2">
                    <div class="card-body">
                        <h4 class="card-title text-center">
                            The average time (in hours) elapsed between the
                                moment an order is created, and the moment is it sent.
                        </h4>
                        <p class="lead display-3 text-center">
                            <t t-esc="stats.average_time" />
                        </p>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="card-body">
                        <h4 class="card-title text-center">
                            The number of cancelled orders, this month.
                        </h4>
                        <p class="lead display-3 text-center">
                            <t t-esc="stats.nb_cancelled_orders" />
                        </p>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="card-body">
                        <h4 class="card-title text-center">
                            The number of new orders, this month.
                        </h4>
                        <p class="lead display-3 text-center">
                            <t t-esc="stats.nb_new_orders" />
                        </p>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="card-body">
                        <h4 class="card-title text-center">
                            The total amount of orders, this month
                        </h4>
                        <p class="lead display-3 text-center">
                            <t t-esc="stats.total_amount" />
                        </p>
                    </div>
                </DashboardItem>
            </t>
        </Layout>
    </t>

</templates>
