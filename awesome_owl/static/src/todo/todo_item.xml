<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todos.item">
        <t t-set="todo" t-value="props.todo" />
        <div class="form-check">
            <input
                class="form-check-input"
                type="checkbox"
                t-att-id="todo.id"
                t-att-checked="todo.isCompleted"
                t-on-change="() => todo.toggleCompleted()"
            />
            <label t-att-class="todo.isCompleted ? 'text-muted text-decoration-line-through' : ''">
                <t t-esc="todo.id"/>. <t t-esc="todo.description"/>
            </label>
            <span class="fa fa-remove ms-3 text-danger" role="button" t-on-click="() => todo.remove()" />
        </div>
    </t>

</templates>
