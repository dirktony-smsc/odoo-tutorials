<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="p-3">
            <p>Hello World!</p>
            <div class="row">
                <div class="col-6">
                    <Counter value="this.counters[0].value" onChange.bind="() => this.incrementSum(0)" />
                    <Counter value="this.counters[1].value" onChange.bind="() => this.incrementSum(1)" />
                </div>
            </div>
            <p> Counter Sum: <t t-esc="this.sum"/> </p>
            <div class="row">
                <div class="col-6">
                    <Card title="'asdsa'" content="'sadsada'" />
                    <Card title="'sadasd'" content="this.html" />
                </div>
            </div>
        </div>
    </t>

</templates>
